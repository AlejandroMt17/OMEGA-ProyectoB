# ================================================================
# .env.example — Sistema de Control de Asistencias
# OMEGA Solutions | MDB-OMEGA-01 §1.4 (Definición de ambientes)
# ================================================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.
#
# Nombre de BD según Diccionario de Datos MDB-OMEGA-DD-01 §1:
#   DEV:  control_asistencias_bd_dev
#   QA:   control_asistencias_bd_qa
#   PROD: control_asistencias_bd_prod
# ================================================================

APP_NAME="Control de Asistencias"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/OMEGA-ProyectoB/backend/public

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de datos MySQL (XAMPP) ──────────────────────────────────
# Puerto por defecto de XAMPP: 3306
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=control_asistencias_bd_dev
DB_USERNAME=root
DB_PASSWORD=

# ── Sesiones ─────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Cache y colas ─────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail (log para desarrollo) ────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@omega.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── PayPal (MPL-OMEGA-05 §6 — Integración de pagos) ──────────────
# Obtén tus credenciales en https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── Sanctum (API tokens) ──────────────────────────────────────────
# Para XAMPP local, el dominio es localhost
SANCTUM_STATEFUL_DOMAINS=localhost

VITE_APP_NAME="${APP_NAME}"
